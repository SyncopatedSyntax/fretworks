{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/chord", "destination": "https://chord-trainer-mauve.vercel.app/chord" },
    { "source": "/chord/(.*)", "destination": "https://chord-trainer-mauve.vercel.app/chord/$1" },

    { "source": "/focus", "destination": "https://focused-chord-trainer.vercel.app/focus" },
    { "source": "/focus/(.*)", "destination": "https://focused-chord-trainer.vercel.app/focus/$1" },

    { "source": "/diatonic", "destination": "https://diatonic-chords-trainer.vercel.app/diatonic" },
    { "source": "/diatonic/(.*)", "destination": "https://diatonic-chords-trainer.vercel.app/diatonic/$1" },

    { "source": "/melodic-minor", "destination": "https://melodic-minor-trainer.vercel.app/melodic-minor" },
    { "source": "/melodic-minor/(.*)", "destination": "https://melodic-minor-trainer.vercel.app/melodic-minor/$1" },

    { "source": "/altered", "destination": "https://altered-trainer.vercel.app/altered" },
    { "source": "/altered/(.*)", "destination": "https://altered-trainer.vercel.app/altered/$1" },

    { "source": "/circle", "destination": "https://circle-of-fifths-beta.vercel.app/circle" },
    { "source": "/circle/(.*)", "destination": "https://circle-of-fifths-beta.vercel.app/circle/$1" },

    { "source": "/triads", "destination": "https://triads-trainer.vercel.app/triads" },
    { "source": "/triads/(.*)", "destination": "https://triads-trainer.vercel.app/triads/$1" },

    { "source": "/standards", "destination": "https://standards-trainer.vercel.app/standards" },
    { "source": "/standards/(.*)", "destination": "https://standards-trainer.vercel.app/standards/$1" },

    { "source": "/notes", "destination": "https://note-trainer-eight.vercel.app/notes" },
    { "source": "/notes/(.*)", "destination": "https://note-trainer-eight.vercel.app/notes/$1" },
    { "source": "/blues", "destination": "https://blues-scale-trainer.vercel.app/blues" },
    { "source": "/blues/(.*)", "destination": "https://blues-scale-trainer.vercel.app/blues/$1" },

    { "source": "/natural-minor", "destination": "https://natural-minor-trainer.vercel.app/natural-minor" },
    { "source": "/natural-minor/(.*)", "destination": "https://natural-minor-trainer.vercel.app/natural-minor/$1" },

    { "source": "/harmonic-minor", "destination": "https://harmonic-minor-trainer.vercel.app/harmonic-minor" },
    { "source": "/harmonic-minor/(.*)", "destination": "https://harmonic-minor-trainer.vercel.app/harmonic-minor/$1" },

    { "source": "/major", "destination": "https://major-scale-trainer-murex.vercel.app/major" },
    { "source": "/major/(.*)", "destination": "https://major-scale-trainer-murex.vercel.app/major/$1" },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
